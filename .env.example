# Copia este archivo como ".env". Con la configuración por defecto TODO ES GRATIS
# y sin tarjeta. Hacen falta DOS claves (Groq está bloqueado por el firewall de la oficina).

# --- Clave 1: Gemini (cerebro). Gratis, sin tarjeta ---
# Entra a https://aistudio.google.com/apikey con tu cuenta de Google -> "Create API key"
GEMINI_API_KEY=

# --- Clave 2: Deepgram (transcripción). Regalan 200 USD de crédito, sin tarjeta ---
# Regístrate en https://console.deepgram.com -> "API Keys" -> "Create a New API Key"
DEEPGRAM_API_KEY=

# --- Proveedores (los valores por defecto son los que pasan el firewall y son gratis) ---
LLM_PROVIDER=cadena      # cadena = varios cerebros gratis con respaldo automático | gemini (gratis) | cerebras (gratis, https://cloud.cerebras.ai) | anthropic (de pago) | groq (BLOQUEADO en la oficina)
STT_PROVIDER=deepgram    # deepgram (crédito gratis) | groq (BLOQUEADO en la oficina) | whisper (local; no se puede descargar aquí, HuggingFace bloqueado)
TTS_PROVIDER=edge        # edge (gratis, voces Microsoft, sin clave) | kokoro (local, sin internet) | elevenlabs (de pago)

# --- Voz de Microsoft Edge (gratis) ---
# Hombre Colombia: es-CO-GonzaloNeural   Mujer Colombia: es-CO-SalomeNeural
# Hombre México:   es-MX-JorgeNeural     Mujer México:   es-MX-DaliaNeural
EDGE_VOICE=es-CO-GonzaloNeural
EDGE_RATE=+0%            # velocidad, ej. -10% más pausado, +10% más rápido
EDGE_PITCH=+0Hz          # tono, ej. -20Hz más grave

# --- Cerebro ---
LLM_MODEL=gemini-3.5-flash-lite   # cupo gratis alto y responde en <1 s. gemini-3.6-flash solo permite 20 respuestas al día gratis
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=300

# --- Transcripción ---
STT_LANGUAGE=es          # "multi" si la gente mezcla español e inglés
STT_MODEL=nova-3-general

# --- Personalidad: nombre de un archivo dentro de la carpeta prompts/ ---
PERSONA=conversador      # o asesor_ventas

# --- Audio ---
# Ejecuta "python dispositivos.py" para ver los índices. Vacío = dispositivo por defecto de Windows.
MIC_DEVICE_INDEX=
SPEAKER_DEVICE_INDEX=
VAD_CONFIDENCE=0.7       # sensibilidad de detección de voz (súbelo a 0.8 si hay ruido de fondo)
VAD_STOP_SECS=0.2        # súbelo a 0.4 si te corta a mitad de frase

LOG_LEVEL=INFO           # DEBUG para ver todo el detalle

# --- Solo si cambias de proveedor ---
# CEREBRAS_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5
# KOKORO_VOICE=em_santa  # voces en español: em_santa, em_alex (hombres), ef_dora (mujer)

# --- Cerebros en cadena (LLM_PROVIDER=cadena). Se usan los que tengan clave, en este orden ---
# Si uno falla o no responde en CADENA_TIMEOUT segundos, pasa al siguiente en el mismo turno.
LLM_CADENA=mistral,nvidia,github,gemini
CADENA_TIMEOUT=4
MISTRAL_API_KEY=             # gratis, solo verifica el celular: https://console.mistral.ai  (plan "Experiment")
NVIDIA_API_KEY=              # gratis con cuenta: https://build.nvidia.com  (botón "Get API Key")
GITHUB_TOKEN=                # gratis con cuenta de GitHub, cupo bajo: https://github.com/settings/tokens
# GEMINI_MODELOS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.1-flash-lite
